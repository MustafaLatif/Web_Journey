<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tasks App</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
  <div class="main w-full min-h-screen bg-zinc-900">

    <!-- Form Section -->
    <div class="form p-10 text-white">
      <form action="/create" method="POST">
        <input
          class="block px-5 py-2 rounded-md w-full bg-zinc-800 mb-3"
          type="text"
          placeholder="Title goes here"
          name="title"
          required
        />

        <textarea
          class="block px-5 py-2 rounded-md w-full bg-zinc-800 mb-3"
          placeholder="Details go here"
          name="details"
          required
        ></textarea>

        <button
          class="px-5 py-2 bg-blue-600 rounded-md hover:bg-blue-700"
        >
          Create Task
        </button>
      </form>
    </div>

    <!-- Tasks Section -->
    <div class="tasks flex gap-3 flex-wrap p-10">
      <% if (files.length > 0) { %>

        <% files.forEach(function(file) { %>
          <div class="task w-72 px-3 py-4 bg-zinc-800 rounded-lg">
            <h1 class="text-white text-3xl tracking-tighter">
              <%= file %>
            </h1>

            <a
              class="text-blue-500 inline-block mt-3"
              href="/files/<%= file %>"
            >
              Read More
            </a>
          </div>
        <% }) %>

      <% } else { %>
        <h3 class="text-zinc-600">no tasks yet.</h3>
      <% } %>
    </div>

  </div>
</body>
</html>
